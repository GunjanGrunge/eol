{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "dev": "pnpm --filter @workspace/eolarity-innovations run dev",
    "start": "pnpm run dev",
    "dev:mockups": "pnpm --filter @workspace/mockup-sandbox run dev",
    "dev:api": "pnpm --filter @workspace/api-server run dev",
    "dev:all": "pnpm -r --parallel run dev",
    "build": "pnpm run typecheck && pnpm -r --if-present run build && node ./scripts/copy-dist.mjs",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck"
  },
  "private": true,
  "dependencies": {
    "@replit/connectors-sdk": "^0.4.3"
  },
  "devDependencies": {
    "@esbuild/win32-x64": "^0.28.2",
    "@rollup/rollup-win32-x64-msvc": "^4.63.5",
    "@tailwindcss/oxide-win32-x64-msvc": "^4.3.3",
    "lightningcss-win32-x64-msvc": "^1.33.0",
    "prettier": "^3.9.6",
    "typescript": "~5.9.3"
  }
}
